[Unit]
Description=Ephemres Monitoring Engine
After=network.target postgresql.service redis-server.service
Requires=postgresql.service
Wants=redis-server.service

[Service]
Type=simple
User=ephemres
Group=ephemres
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
WorkingDirectory=/opt/ephemres
EnvironmentFile=-/etc/ephemres/ephemres.env
EnvironmentFile=-/opt/ephemres/.env
EnvironmentFile=-/opt/ephemres/backend/.env
Environment=PYTHONPATH=/opt/ephemres/backend:/opt/ephemres
ExecStart=/opt/ephemres/venv/bin/python -m monitoring.engine
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ephemres-engine

[Install]
WantedBy=multi-user.target
