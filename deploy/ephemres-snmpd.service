[Unit]
Description=Ephemres SNMP Poller (interfaces, status, reboots)
After=network.target postgresql.service
Wants=postgresql.service

# Always enabled and running: it polls nothing while SNMP is off in Settings, so the web UI
# turns SNMP on and off without starting or stopping a service (no sudo rule, unlike flowd).
[Service]
Type=notify
WatchdogSec=45
NotifyAccess=all
User=ephemres
Group=ephemres
# Sends from ephemeral UDP ports only: no capabilities at all.
CapabilityBoundingSet=
NoNewPrivileges=yes
RuntimeDirectory=ephemres
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
WorkingDirectory=/opt/ephemres
EnvironmentFile=/etc/ephemres/ephemres.env
EnvironmentFile=-/opt/ephemres/.env
EnvironmentFile=-/opt/ephemres/backend/.env
Environment=PYTHONPATH=/opt/ephemres/backend:/opt/ephemres
Environment=HOME=/opt/ephemres
ExecStart=/opt/ephemres/venv/bin/python -m monitoring.snmp.daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ephemres-snmpd

[Install]
WantedBy=multi-user.target
