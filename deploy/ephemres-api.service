[Unit]
Description=Ephemres API Server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=notify
WatchdogSec=45
NotifyAccess=all
User=ephemres
Group=ephemres
RuntimeDirectory=ephemres
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# Raw ICMP for in-process traceroute/diagnostics. No CapabilityBoundingSet here: the API calls
# `sudo -n systemctl ... ephemres-flowd`, and sudo needs CAP_SETUID/CAP_SETGID from the bounding set.
AmbientCapabilities=CAP_NET_RAW
WorkingDirectory=/opt/ephemres/backend
EnvironmentFile=-/etc/ephemres/ephemres.env
EnvironmentFile=-/opt/ephemres/.env
EnvironmentFile=-/opt/ephemres/backend/.env
ExecStart=/opt/ephemres/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ephemres-api

[Install]
WantedBy=multi-user.target
